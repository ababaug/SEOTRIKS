generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}


model User {
  id      String    @id @default(cuid())
  email   String    @unique
  name    String?
  role    String    @default("USER")
  projects Project[]
}

model Project {
  id      String @id @default(cuid())
  name    String
  domain  String
  userId  String
  user    User   @relation(fields: [userId], references: [id])
}
