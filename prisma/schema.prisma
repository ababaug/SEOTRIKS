generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String    @id @default(uuid())
  name        String
  billingPlan String    @default("FREE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users       User[]
  projects    Project[]
}

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  name           String?
  password       String?
  role           String        @default("MEMBER")
  organizationId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization? @relation(fields: [organizationId], references: [id])
  auditLogs      AuditLog[]
}

model Project {
  id             String       @id @default(uuid())
  name           String
  domain         String
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  keywords       Keyword[]
  backlinks      Backlink[]
  siteAudits     SiteAudit[]
  reports        Report[]
}

model Keyword {
  id          String   @id @default(uuid())
  term        String
  volume      Int?
  difficulty  Int?
  currentRank Int?
  projectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id])
}

model SiteAudit {
  id           String    @id @default(uuid())
  healthScore  Float?
  pagesCrawled Int       @default(0)
  issuesFound  Int       @default(0)
  status       String    @default("PENDING")
  projectId    String
  startedAt    DateTime  @default(now())
  completedAt  DateTime?

  project      Project   @relation(fields: [projectId], references: [id])
}

model Backlink {
  id              String   @id @default(uuid())
  url             String
  domainAuthority Int?
  anchorText      String?
  status          String   @default("ACTIVE")
  projectId       String
  discoveredAt    DateTime @default(now())

  project         Project  @relation(fields: [projectId], references: [id])
}

model Report {
  id        String   @id @default(uuid())
  title     String
  type      String
  config    String
  projectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String
  userId     String
  details    String?
  timestamp  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
}
